# Skopiuj ten plik jako ".env" i wpisz swoje klucze. Pliku .env nikomu nie wysyłaj!

# Token od @BotFather
TELEGRAM_TOKEN=

# Klucz z https://console.groq.com/keys (transkrypcja głosówek)
GROQ_API_KEY=

# Klucz z https://platform.deepseek.com/api_keys (streszczenia)
DEEPSEEK_API_KEY=

# Model DeepSeek do streszczeń
DEEPSEEK_MODEL=deepseek-chat

# ID Twojej grupy (napisz /id w grupie). Puste = bot działa wszędzie
ALLOWED_CHAT_IDS=

# Głosówki krótsze niż tyle sekund /skracaj tylko przepisuje na tekst (bez streszczenia)
MIN_DURATION_SECONDS=9
